# Local dev — file-based SQLite (no Turso account needed)
TURSO_DATABASE_URL=file:./local.db

# Turso cloud (when you're ready to deploy)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Dev seed user password (default: plotdev)
# SEED_DEV_PASSWORD=plotdev

# Phase 1 — natural language parsing via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash
# Vision model for photo analysis. Defaults to OPENROUTER_MODEL (gemini-2.5-flash-lite
# is vision-capable). Set a fallback only if it accepts images.
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_VISION_FALLBACK_MODEL=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Attachment storage — S3-compatible object store (AWS S3 or Cloudflare R2).
# Required for uploads in production (serverless filesystems are ephemeral).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# region: use "auto" for Cloudflare R2, or e.g. us-east-1 for AWS S3
S3_REGION=auto
# endpoint: required for R2 (https://<account-id>.r2.cloudflarestorage.com); omit for AWS S3
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true   # often needed for R2/MinIO
# S3_KEY_PREFIX=attachments  # namespaces objects within the bucket (default: attachments)
